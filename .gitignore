# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# Secrets — never commit
.env
frontend/.env.local

# Regenerable: rebuild with `python -m pipeline.run`
data/raw/pages.json
data/raw/pdfs.json
data/chunks.json

# data/raw/pdfs/ IS tracked: those source documents (the Aliens Act, the
# Integration Act, Kela forms) are downloaded by hand, not by the crawler, so
# losing them would silently shrink the corpus with nothing to rebuild from.
!data/raw/pdfs/

# Eval output
eval/results*.json

# Claude Code local config (machine-specific)
.claude/

# OS
.DS_Store
Thumbs.db
