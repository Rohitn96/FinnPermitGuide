# Copy to .env and fill in. Never commit .env.

OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcsk_...

# The corpus being served. pipeline/index.py creates migri-guide-YYYYMMDD.
PINECONE_INDEX_NAME=migri-guide

# Local development only. In production set EDGE_SHARED_SECRET instead — with
# neither set, /ask rejects every request, which is the intended fail-closed
# behaviour rather than a silently open endpoint.
ALLOW_UNAUTHENTICATED=true

# Optional overrides — see rag/config.py for defaults.
# ANSWER_MODEL=gpt-5.4-mini
# CONTEXT_CHUNKS=12
