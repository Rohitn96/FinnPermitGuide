# Cloudflare Pages builds this project with:
#   npm install --legacy-peer-deps && npx @cloudflare/next-on-pages@1
#
# The --legacy-peer-deps flag covers the first install but NOT the transient
# install npx performs to fetch next-on-pages itself, and that one fails:
# next-on-pages@1.13.16 declares a peer on @cloudflare/workers-types@^4 while
# current wrangler declares ^5, so npm aborts with ERESOLVE and the deploy dies
# before the build starts. Nothing in this repo caused it — wrangler moved to v5
# upstream, which silently broke every subsequent Pages build.
#
# Setting it here applies to every npm invocation in this directory, npx
# included, which is what actually unblocks the build.
#
# This is a workaround holding up a deprecated tool: next-on-pages is retired in
# favour of the OpenNext adapter (https://opennext.js.org/cloudflare). Migrating
# is the real fix and should happen before the next Next.js upgrade.
legacy-peer-deps=true
